<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imageUpgrade"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/upgrade_icon"
            android:src="@drawable/ic_upgrade_1"
            tools:src="@drawable/ic_upgrade_1"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textUpgradeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_upgrade_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Cursor"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textUpgradeDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/default_upgrade_description"
                android:textColor="@color/text_secondary"
                tools:text="Generates coins automatically."/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textUpgradeLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/default_upgrade_level"
                android:textColor="@color/text_secondary"
                tools:text="Level: 3"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textUpgradeIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_upgrade_income"
                android:textColor="@color/success"
                tools:text="+10 coins/s"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBuy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buy"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/default_upgrade_price"
                android:textColor="@color/text_primary"
                tools:text="100"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>